#!name = Meitu VIP Pro Max
#!desc = Mở khóa VIP vĩnh viễn Meitu (美图秀秀): Toàn bộ Bộ lọc (Filters), Hiệu ứng VIP, Công cụ Retouch & Xóa vật thể
#!author = Namdepzai929
#!system = iOS

[Script]
# 1. Mở khóa VIP Meitu Xiuxiu (Profile, VIP Status, Rights, Filter Packs)
MeituVIP_Main = type=http-response,pattern=^https?:\/\/(h5|api)\.xiuxiu\.meitu\.com\/v\d+\/(h\d+\/vip|vip|user|material)\/,script-path=https://raw.githubusercontent.com/Namdepzai929/MyModules/refs/heads/main/meitu_vip.js,requires-body=true,max-size=-1,timeout=60

# 2. Mở khóa Server Subscription VIP Meitu Ecosystem
MeituVIP_Sub = type=http-response,pattern=^https?:\/\/api-sub\.meitu\.com\/v2\/(user\/vip_info|user\/vip_info_by_group|user\/login_vip_check|contract\/sub\/get_valid_contract|transaction\/permission_check)\.json,script-path=https://raw.githubusercontent.com/Namdepzai929/MyModules/refs/heads/main/meitu_vip.js,requires-body=true,max-size=-1,timeout=60

# 3. Mở khóa Quota dùng thử không giới hạn & Hạt đậu ảo (Meidou Coins)
MeituVIP_Quota = type=http-response,pattern=^https?:\/\/api-sub\.meitu\.com\/(v2\/function\/(user\/check|strategy\/free)|v2\/entrance\/products_by_function|v1\/meidou\/account\/balance)\.json,script-path=https://raw.githubusercontent.com/Namdepzai929/MyModules/refs/heads/main/meitu_vip.js,requires-body=true,max-size=-1,timeout=60

[MITM]
hostname = %APPEND%, api.xiuxiu.meitu.com, h5.xiuxiu.meitu.com, api-sub.meitu.com
